# ==============================================================================
# 🌐 TechRadar-Harness 全域配置模板 (Environment Variables)
# ==============================================================================

# 🤖 大模型提供商配置 (OpenAI 兼容协议: DeepSeek / OpenAI / Ollama / OpenRouter)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_or_openai_api_key_here
LLM_MODEL=deepseek-chat
LLM_MAX_RETRIES=2

# 🗄️ 数仓存储引擎驱动 ("sqlite" 零依赖开箱即用 | "postgres" 企业级数仓 | "memory" 测试)
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/radar_store.json
# 若切换为 postgres 则配置以下连接串:
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/crawler_db

# 🔌 网络代理与路由分流配置
# PROXY_MODE: "auto" (国内直连防WAF，国外走代理) | "always" (全局代理) | "never" (全局直连)
PROXY_MODE=auto
PROXY_URL=http://127.0.0.1:7897
PROXY_AUTH=username:password
DOMESTIC_DOMAINS=tech.meituan.com,ruanyifeng.com,.cn,v2ex.com,juejin.cn,csdn.net

# 📚 Obsidian 知识库根路径 (支持 Windows 与 WSL 路径自动识别)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# 🎨 排版主题风格 ("geek" | "standard" | "academic")
TYPOGRAPHY_THEME=geek

# 📦 启用的任务集 (以英文逗号分隔)
TASKS_ENABLED=github,papers,news,books,synthesizer
